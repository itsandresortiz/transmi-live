  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@transmi/domain": ["../../packages/domain/src/index.ts"],
      "@transmi/application": ["../../packages/application/src/index.ts"],
      "@transmi/infrastructure": ["../../packages/infrastructure/src/index.ts"]
