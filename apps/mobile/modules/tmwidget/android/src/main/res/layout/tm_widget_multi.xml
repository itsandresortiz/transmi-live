                android:textColor="@color/tm_widget_text" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/tm_s3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginTop="10dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
