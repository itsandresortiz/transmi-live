                android:textColor="@color/tm_widget_text" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/tm_s2" android:layout_width="match_parent" android:layout_height="wrap_content"
