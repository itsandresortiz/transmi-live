{
  "expo": {
    "name": "TransMi LIVE",
    "slug": "transmi-live",
    "scheme": "transmilive",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.transmilive.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.transmilive.app"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TransMi LIVE usa tu ubicación para mostrarte las paradas cercanas y cómo llegar. No se guarda ni se comparte."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
